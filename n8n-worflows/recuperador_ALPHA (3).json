              "name": "body.ticket.buyer_phone",
              "value": "={{(() => {\n  const raw = ( $json.body.ticket.buyer_phone || '').trim(); // eliminar \\n, espacios, etc.\n  const digits = raw.replace(/\\D/g, ''); // Quitar todo lo que no sea número\n\n  if (digits.startsWith('56') && digits.length === 11) {\n    return `${digits}`;\n  }\n\n  if (digits.startsWith('9') && digits.length === 9) {\n    return `56${digits}`;\n  }\n\n  if (digits.length === 8) {\n    return `569${digits}`;\n  }\n\n  if (raw.startsWith('569') && digits.length === 11) {\n    return raw; // ya está bien\n  }\n\n  return raw; // fallback\n})()}}",
              "type": "string"
            },
